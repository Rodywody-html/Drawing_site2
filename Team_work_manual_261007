<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#faf9f5;color:#141413}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>고객경험관리팀 업무 매뉴얼 (Copy)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500&display=swap">
<style>
/* Layout: 왼쪽 아코디언 목차 + 오른쪽에 선택한 항목 한 페이지만 표시 */
:root {
  --bg: #f6f7f9;
  --surface: #ffffff;
  --fg: #1b2230;
  --muted: #5d6676;
  --line: #dde1e8;
  --accent: #1f5fbf;
  --accent-soft: #e6eefb;
  --pending: #8a6a12;
  --pending-soft: #f7efd6;
  --done: #0f7a5c;
  --done-soft: #e3f3ec;
  --warn: #b3471d;
  --warn-soft: #fbece4;
  --caps: #b42b3c;
  --caps-soft: #f9e6e9;
  --hit: #ffe58a;
  --shadow: rgba(20, 30, 50, .12);
  --font-body: "Noto Sans KR", "Apple SD Gothic Neo", "Malgun Gothic", system-ui, sans-serif;
  --font-mono: "IBM Plex Mono", ui-monospace, Menlo, Consolas, monospace;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #12161d; --surface: #1a1f28; --fg: #e5e9f0; --muted: #9aa3b2; --line: #2c3340;
    --accent: #7aa9f0; --accent-soft: #1d2a40; --pending: #e0c068; --pending-soft: #33301d;
    --done: #5cc9a3; --done-soft: #17302a; --warn: #f0a07a; --warn-soft: #3a2519; --caps: #f08a98; --caps-soft: #3a1d23; --hit: #6b5a12; --shadow: rgba(0, 0, 0, .4); color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --bg: #12161d; --surface: #1a1f28; --fg: #e5e9f0; --muted: #9aa3b2; --line: #2c3340;
  --accent: #7aa9f0; --accent-soft: #1d2a40; --pending: #e0c068; --pending-soft: #33301d;
  --done: #5cc9a3; --done-soft: #17302a; --warn: #f0a07a; --warn-soft: #3a2519; --caps: #f08a98; --caps-soft: #3a1d23; --hit: #6b5a12; --shadow: rgba(0, 0, 0, .4); color-scheme: dark;
}

* { box-sizing: border-box; }
body {
  background: var(--bg); color: var(--fg);
  font-family: var(--font-body); font-size: 15px; line-height: 1.7;
  word-break: keep-all;
}
a { color: inherit; }
a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 6px; }
ol { list-style: none; margin: 0; padding: 0; }
button { font: inherit; color: inherit; }

.shell {
  display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px;
  max-width: 1080px; margin: 0 auto; padding: 28px 24px 80px;
}

/* 목차 */
.toc { position: sticky; top: calc(env(safe-area-inset-top, 0px) + 20px); align-self: start;
  max-height: calc(100vh - 40px); overflow-y: auto; padding-right: 4px; }
.toc-title { display: block; text-decoration: none; font-weight: 700; font-size: 15px; padding: 4px 10px 12px; }
.toc-title small { display: block; font-size: 12px; color: var(--muted); font-weight: 500; }
.cat + .cat { margin-top: 2px; }
.cat-btn {
  width: 100%; display: flex; align-items: center; gap: 8px; text-align: left;
  background: none; border: 0; padding: 7px 10px; border-radius: 6px; cursor: pointer; font-weight: 600;
}
.cat-btn:hover { background: var(--accent-soft); }
.cat.current > .cat-btn { color: var(--accent); }
.cat-btn .t { flex: 1; min-width: 0; }
.cnt { font-family: var(--font-mono); font-size: 12px; color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; }
.chev { width: 7px; height: 7px; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(-45deg); transition: transform .15s; margin-right: 2px; }
.cat-btn[aria-expanded="true"] .chev { transform: rotate(45deg); }
@media (prefers-reduced-motion: reduce) { .chev { transition: none; } }
.num { font-family: var(--font-mono); font-size: 13px; color: var(--muted); min-width: 1.6em; font-variant-numeric: tabular-nums; font-weight: 500; }
.cat.current > .cat-btn .num { color: var(--accent); }

.sub { margin: 2px 0 8px 18px; border-left: 1px solid var(--line); }
.sub a { display: flex; gap: 8px; text-decoration: none; color: var(--muted); padding: 4px 10px; font-size: 14px; border-radius: 0 6px 6px 0; }
.sub a:hover { color: var(--fg); background: var(--accent-soft); }
.sub a.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }
.sub a.active .num { color: var(--accent); }
.sub .num { min-width: 2.6em; font-size: 12px; }
.grp-name { display: flex; gap: 8px; padding: 6px 10px 2px; font-size: 13px; font-weight: 700; color: var(--fg); }
.grp-name .num { min-width: 2.6em; font-size: 12px; }
.grp ol { margin-left: 14px; border-left: 1px dashed var(--line); }

/* 본문 공통 */
main { min-width: 0; }
main:focus { outline: none; }
.eyebrow { font-size: 12px; letter-spacing: .08em; color: var(--muted); font-weight: 600; margin: 0 0 6px; }
h1 { font-size: 30px; line-height: 1.3; margin: 0 0 10px; text-wrap: balance; }
.home > p { margin: 0; color: var(--muted); max-width: 60ch; }
.meta { display: flex; flex-wrap: wrap; gap: 8px 20px; margin-top: 14px; font-size: 13px; color: var(--muted); }
.meta b { color: var(--fg); font-weight: 600; font-variant-numeric: tabular-nums; }
.howto { margin-top: 22px; padding: 14px 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font-size: 14px; color: var(--muted); }
.howto b { color: var(--fg); }

.cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; margin-top: 24px; }
.cat-card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 14px 16px; min-width: 0; }
.cat-card-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
.cat-card-head h3 { margin: 0; font-size: 16px; flex: 1; }
.tag { font-family: var(--font-mono); font-size: 12px; padding: 1px 7px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); }
.chips { display: flex; flex-wrap: wrap; gap: 6px; }
.chip { font-size: 13px; text-decoration: none; padding: 2px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--fg); }
.chip:hover { border-color: var(--accent); color: var(--accent); }

/* 항목 페이지 */
.crumbs { display: flex; flex-wrap: wrap; gap: 6px; font-size: 13px; color: var(--muted); }
.crumbs > * + *::before { content: "›"; margin-right: 6px; color: var(--line); }
.crumbs a { text-decoration: none; }
.crumbs a:hover { color: var(--accent); }
.page-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px; margin: 8px 0 24px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
.page-num { font-family: var(--font-mono); font-size: 16px; color: var(--accent); }
.page-head h2 { font-size: 28px; line-height: 1.3; margin: 0; }
.status { margin-left: auto; font-size: 12px; font-weight: 600; padding: 2px 10px; border-radius: 999px; background: var(--pending-soft); color: var(--pending); white-space: nowrap; align-self: center; }
.status.done { background: var(--done-soft); color: var(--done); }
.sec { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px; }
.sec + .sec { margin-top: 12px; }
.sec h3 { font-size: 16px; margin: 0 0 6px; }
.sec p, .sec ul, .sec ol { margin: 0; max-width: 68ch; }
.todo { color: var(--muted); font-size: 14px; }
.pager { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 28px; }
.pn { display: block; text-decoration: none; padding: 12px 16px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); font-weight: 600; min-width: 0; }
.pn small { display: block; font-size: 12px; color: var(--muted); font-weight: 500; }
.pn:hover { border-color: var(--accent); color: var(--accent); }
.pn.next { text-align: right; }

@media (max-width: 820px) {
  .shell { grid-template-columns: minmax(0, 1fr); gap: 20px; padding: 16px 16px 64px; }
  .toc { position: static; max-height: none; overflow: visible; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 10px; }
  h1 { font-size: 24px; }
  .page-head h2 { font-size: 23px; }
  .status { margin-left: 0; }
  .sec { padding: 14px 16px; }
}

/* 목차·홈: 내용 있는 항목 표시 */
.dot { width: 6px; height: 6px; border-radius: 50%; background: var(--done); align-self: center; flex: none; }
.chip.filled { border-color: var(--done); color: var(--done); background: var(--done-soft); }
.legend { display: inline-flex; align-items: center; gap: 6px; }
.legend .dot { display: inline-block; }

/* 본문 구성 요소 */
.role { display: inline-block; font-size: 11px; font-weight: 700; padding: 0 7px; border-radius: 4px; margin-left: 6px; vertical-align: 2px; line-height: 1.7; }
.role.r-seedn { background: var(--accent-soft); color: var(--accent); }
.role.r-partner { background: var(--bg); color: var(--muted); border: 1px solid var(--line); }
.role.r-caps { background: var(--caps-soft); color: var(--caps); }
.role.r-cust { background: var(--done-soft); color: var(--done); }
td .role { margin-left: 0; }
.content { max-width: 760px; }
.content > * + * { margin-top: 14px; }
.content h3 { font-size: 18px; margin-top: 34px; padding-top: 2px; }
.content h3:first-child { margin-top: 0; }
.content h4 { font-size: 15px; margin: 22px 0 0; }
.content p, .content ul { margin-bottom: 0; }
.content ul { padding-left: 1.2em; }
.content ul li + li { margin-top: 4px; }
.lead { font-size: 16px; color: var(--fg); padding: 14px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; margin: 0; }
.muted { color: var(--muted); font-size: 13px; }
.xref { color: var(--accent); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; font-weight: 600; }
.ext { color: var(--accent); }
.ext::after { content: " ↗"; font-size: .85em; }

.steps { counter-reset: st; display: grid; gap: 0; }
.steps > li { counter-increment: st; display: grid; grid-template-columns: 28px minmax(0, 1fr); column-gap: 12px; position: relative; padding-bottom: 14px; }
.steps > li::before { content: counter(st); grid-row: 1 / span 2; width: 26px; height: 26px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); font-family: var(--font-mono); font-size: 13px; display: grid; place-items: center; }
.steps > li:not(:last-child)::after { content: ""; position: absolute; left: 13px; top: 30px; bottom: 2px; width: 1px; background: var(--line); }
.steps > li:last-child { padding-bottom: 0; }
.steps > li > b { display: block; font-weight: 700; }
.steps > li > span { color: var(--fg); min-width: 0; }
.steps > li > b + span { color: var(--muted); }

.note { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 10px; padding: 12px 16px; border-radius: 8px; font-size: 14px; background: var(--accent-soft); }
.note > b { font-size: 12px; font-weight: 700; padding: 1px 8px; border-radius: 4px; align-self: start; margin-top: 2px; background: var(--surface); color: var(--accent); white-space: nowrap; }
.note.warn { background: var(--warn-soft); }
.note.warn > b { color: var(--warn); }
.note.todo { background: transparent; border: 1px dashed var(--line); color: var(--muted); }
.note.todo > b { color: var(--pending); background: var(--pending-soft); }

.tbl-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
table { border-collapse: collapse; width: 100%; font-size: 14px; }
th, td { text-align: left; vertical-align: top; padding: 9px 14px; border-bottom: 1px solid var(--line); }
th { font-size: 12px; font-weight: 600; color: var(--muted); background: var(--bg); white-space: nowrap; letter-spacing: .02em; }
tbody tr:last-child td { border-bottom: 0; }
td:first-child { font-weight: 600; white-space: nowrap; }
table.num td:last-child { font-variant-numeric: tabular-nums; text-align: right; }
table.num th:last-child { text-align: right; }

.case { border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.content .case + .case { margin-top: 8px; }
.case > summary { list-style: none; cursor: pointer; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; padding: 13px 18px 13px 40px; position: relative; border-radius: 10px; }
.case > summary::-webkit-details-marker { display: none; }
.case > summary::before { content: ""; position: absolute; left: 18px; top: 21px; width: 7px; height: 7px; border-right: 1.5px solid var(--muted); border-bottom: 1.5px solid var(--muted); transform: rotate(-45deg); transition: transform .15s; }
.case[open] > summary::before { transform: rotate(45deg); top: 18px; }
.case > summary:hover { background: var(--accent-soft); }
.case > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.case-t { font-weight: 700; }
.case-s { font-size: 13px; color: var(--muted); }
.case-body { padding: 4px 18px 18px; border-top: 1px solid var(--line); }
.case-body > * + * { margin-top: 12px; }
.case-body > :first-child { margin-top: 14px; }
@media (prefers-reduced-motion: reduce) { .case > summary::before { transition: none; } }

.script { border: 1px solid var(--line); border-radius: 8px; background: var(--bg); overflow: hidden; }
.script + .script { margin-top: 8px; }
.script-head { display: flex; align-items: center; gap: 8px; padding: 6px 8px 6px 14px; border-bottom: 1px solid var(--line); font-size: 13px; font-weight: 600; }
.script-head span { flex: 1; min-width: 0; }
.copy { border: 1px solid var(--line); background: var(--surface); border-radius: 6px; padding: 2px 10px; font-size: 12px; cursor: pointer; color: var(--muted); }
.copy:hover { color: var(--accent); border-color: var(--accent); }
.copy.ok { color: var(--done); border-color: var(--done); }
.script-body { white-space: pre-wrap; padding: 12px 14px; font-size: 14px; line-height: 1.75; }

.duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
.duo-col { min-width: 0; display: flex; flex-direction: column; gap: 8px; }
.duo-col > * { margin: 0; }
.duo-col h4 { margin-top: 6px; }
.svc { align-self: flex-start; font-size: 12px; font-weight: 700; padding: 1px 10px; border-radius: 4px; }
.svc.caps { background: var(--caps-soft); color: var(--caps); }
.svc.leaf { background: var(--done-soft); color: var(--done); }

.flow { margin-inline: 0; margin-bottom: 0; padding: 18px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.flow figcaption { font-weight: 700; margin-bottom: 14px; text-wrap: balance; }
.flow ol { display: grid; gap: 0; }
.flow li { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 28px; position: relative; padding-bottom: 22px; }
.flow li:last-child { padding-bottom: 0; }
.flow li:not(:last-child)::after { content: ""; position: absolute; left: 25%; bottom: 3px; height: 18px; border-left: 1.5px solid var(--line); }
.fbox { grid-column: 1; border: 1.5px solid var(--line); border-radius: 8px; padding: 9px 12px; text-align: center; background: var(--surface); }
.fbox b { display: block; font-size: 14px; }
.fbox span { display: block; font-size: 12px; color: var(--muted); }
.fbox.q { border-style: dashed; border-radius: 22px; }
.fbox.end { border-color: var(--accent); background: var(--accent-soft); }
.fyes { grid-column: 2; grid-row: 1; display: flex; align-items: center; gap: 10px; position: relative; }
.fyes em, .fno { font-style: normal; font-size: 12px; color: var(--muted); }
.fyes .fbox { flex: 1; grid-column: auto; }
.fyes::before { content: ""; position: absolute; left: -28px; width: 28px; top: 50%; border-top: 1.5px solid var(--line); }
.fno { position: absolute; left: calc(25% + 8px); bottom: 2px; }

.timeline { display: grid; gap: 0; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
.timeline li { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 14px; padding: 12px 16px; }
.timeline li + li { border-top: 1px solid var(--line); }
.timeline time { font-family: var(--font-mono); font-size: 14px; color: var(--accent); font-variant-numeric: tabular-nums; padding-top: 1px; }
.timeline b { display: block; }
.timeline div { color: var(--muted); font-size: 14px; }
.timeline div b { color: var(--fg); font-size: 15px; }

@media (max-width: 640px) {
  .duo { grid-template-columns: minmax(0, 1fr); }
  .flow { padding: 14px; }
  .flow li { grid-template-columns: minmax(0, 1fr); row-gap: 8px; }
  .fyes { grid-column: 1; grid-row: auto; padding-left: 16px; }
  .fyes::before { display: none; }
  .flow li:not(:last-child)::after { left: 50%; }
  .fno { left: calc(50% + 8px); }
  td:first-child { white-space: normal; }
}

[hidden] { display: none !important; }
/* ---------- 검색 · 동기화 ---------- */
.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
.search { padding: 0 2px 8px; }
.search input { width: 100%; font: inherit; font-size: 14px; color: var(--fg); background: var(--surface); border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; }
.search input:focus { outline: 2px solid var(--accent); outline-offset: 0; border-color: var(--accent); }
.search-results { margin-top: 6px; background: var(--surface); border: 1px solid var(--line); border-radius: 8px; max-height: 60vh; overflow-y: auto; }
.search-results li + li { border-top: 1px solid var(--line); }
.search-results a { display: block; padding: 8px 12px; text-decoration: none; }
.search-results a:hover, .search-results a.on { background: var(--accent-soft); }
.sr-title { display: block; font-weight: 700; font-size: 14px; }
.sr-crumb { display: block; font-size: 12px; color: var(--muted); }
.sr-snip { display: block; font-size: 12px; color: var(--muted); margin-top: 2px; line-height: 1.55; }
.sr-empty { padding: 10px 12px; font-size: 13px; color: var(--muted); }
.search-results mark, mark.hit { background: var(--hit); color: inherit; border-radius: 2px; padding: 0 1px; }
mark.hit { box-shadow: 0 0 0 2px var(--hit); }
.sync { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--muted); padding: 2px 10px 6px; }
.sync-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--line); flex: none; }
.sync.live .sync-dot { background: var(--done); box-shadow: 0 0 0 3px var(--done-soft); }
.sync.off .sync-dot { background: var(--pending); }
.toc-hist { display: flex; align-items: center; gap: 8px; text-decoration: none; font-weight: 600; font-size: 14px; padding: 6px 10px; border-radius: 6px; margin-bottom: 8px; border: 1px solid var(--line); background: var(--surface); }
.toc-hist .cnt { margin-left: auto; }
.toc-hist:hover, .toc-hist.active { border-color: var(--accent); color: var(--accent); }

/* ---------- 버튼 ---------- */
.btn { text-decoration: none; display: inline-block; font: inherit; font-size: 13px; font-weight: 600; border-radius: 7px; padding: 5px 14px; cursor: pointer; border: 1px solid var(--line); background: var(--surface); color: var(--fg); }
.btn:hover { border-color: var(--accent); color: var(--accent); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--surface); }
.btn.primary:hover { filter: brightness(1.08); color: var(--surface); }
.btn.ghost { background: transparent; }
.btn.small { font-size: 12px; padding: 3px 10px; }
.btn:disabled { opacity: .6; cursor: default; }
.btn.armed { border-color: var(--warn); color: var(--warn); }

/* ---------- 페이지 도구 · 편집 ---------- */
.page-head { margin-bottom: 10px; padding-bottom: 14px; }
.page-tools { display: flex; align-items: center; gap: 12px; margin: 0 0 22px; font-size: 13px; color: var(--muted); }
.page-meta { flex: 1; min-width: 0; }
.empty-note { display: none; color: var(--muted); padding: 22px; border: 1px dashed var(--line); border-radius: 10px; text-align: center; }
article.is-empty .empty-note { display: block; }

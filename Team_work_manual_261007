    <span class="tb-label" id="tb-label">표</span>
    <span class="tb-grp"><span class="tb-k">행</span>
      <button type="button" data-tb="row-above">위에 추가</button>
      <button type="button" data-tb="row-below">아래에 추가</button>
      <button type="button" data-tb="row-up" title="행을 위로 옮기기">↑</button>
      <button type="button" data-tb="row-down" title="행을 아래로 옮기기">↓</button>
      <button type="button" data-tb="row-del" class="tb-del">삭제</button></span>
    <span class="tb-grp"><span class="tb-k">열</span>
      <button type="button" data-tb="col-left">왼쪽에 추가</button>
      <button type="button" data-tb="col-right">오른쪽에 추가</button>
      <button type="button" data-tb="col-l" title="열을 왼쪽으로 옮기기">←</button>
      <button type="button" data-tb="col-r" title="열을 오른쪽으로 옮기기">→</button>
      <button type="button" data-tb="col-del" class="tb-del">삭제</button></span>
    <span class="tb-grp">
      <button type="button" data-tb="head" title="첫 행을 머리글로 쓰거나 일반 행으로 바꿉니다">머리글 행</button>
      <button type="button" data-tb="tbl-del" class="tb-del">표 삭제</button></span>
    <span class="tb-tip">Tab 다음 칸 · Shift+Tab 이전 칸 · 마지막 칸에서 Tab 새 행</span>
  </div>
  <div class="editbar-actions">
    <span class="editbar-msg" id="editbar-msg"></span>
    <button type="button" class="btn ghost" id="edit-cancel">취소</button>
    <button type="button" class="btn primary" id="edit-save">저장</button>
  </div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite" hidden></div>

<script>
(function () {
  'use strict';
  var $ = function (s, r) { return (r || document).querySelector(s); };
  var $$ = function (s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); };
  var main = $('#main');
  var views = $$('[data-page]');
  var tocLinks = $$('.sub a');
  var cats = $$('.cat');

  /* ---------- 공통 ---------- */
  var toastTimer;
  function toast(msg, ms) {
    var t = $('#toast'); t.textContent = msg; t.hidden = false;
    clearTimeout(toastTimer); toastTimer = setTimeout(function () { t.hidden = true; }, ms || 3200);
  }
  function pad(n) { return (n < 10 ? '0' : '') + n; }
  function fmt(ms, withYear) {
    var d = new Date(ms);
    return (withYear ? d.getFullYear() + '.' : '') + pad(d.getMonth() + 1) + '.' + pad(d.getDate()) + ' ' + pad(d.getHours()) + ':' + pad(d.getMinutes());
  }
  function el(tag, cls, text) { var e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; return e; }
  function norm(s) { return (s || '').replace(/\s+/g, ' ').trim(); }

  /* ---------- 페이지 레지스트리 ---------- */
  var pages = {};
  $$('article.page[data-title]').forEach(function (a) {
    var c = $('.content', a);
    pages[a.getAttribute('data-page')] = {
      a: a, c: c, title: a.getAttribute('data-title'), crumb: a.getAttribute('data-crumb'),
      base: c.innerHTML, override: null
    };
  });

  /* ---------- 내비게이션 ---------- */
  var current = 'home';
  function setOpen(cat, open) {
    $('.cat-btn', cat).setAttribute('aria-expanded', open ? 'true' : 'false');
    $('.sub', cat).hidden = !open;
  }
  $$('.cat-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { setOpen(btn.closest('.cat'), btn.getAttribute('aria-expanded') !== 'true'); });
  });
  function show(id, fromClick) {
    if (editing && id !== editing.slug) { toast('수정 중입니다. 먼저 저장하거나 취소해 주세요.'); return false; }
    var target = views.filter(function (v) { return v.getAttribute('data-page') === id; })[0];
    if (!target) { id = 'home'; target = views[0]; }
    views.forEach(function (v) { v.hidden = v !== target; });
    current = id;
    clearHits();
    tocLinks.forEach(function (a) { a.classList.toggle('active', a.getAttribute('data-go') === id); });
    $('.toc-hist').classList.toggle('active', id === 'history');
    var catNo = target.getAttribute('data-cat');
    cats.forEach(function (c) {
      var mine = c.getAttribute('data-cat') === catNo;
      c.classList.toggle('current', mine);
      if (mine) setOpen(c, true);
    });
    if (fromClick) {
      if (window.matchMedia('(max-width: 820px)').matches) main.scrollIntoView({ block: 'start' });
      else window.scrollTo(0, 0);
      main.focus({ preventScroll: true });
    }
    return true;
  }
  function go(id) {
    if (show(id, true)) { try { history.replaceState(null, '', '#' + id); } catch (err) {} }
  }
  document.addEventListener('click', function (e) {
    var a = e.target.closest('[data-go]');
    if (!a) return;
    if (a.closest('[contenteditable="true"]')) { e.preventDefault(); return; }
    e.preventDefault();
    go(a.getAttribute('data-go'));
  });
  window.addEventListener('hashchange', function () { show(location.hash.slice(1) || 'home', true); });

  /* ---------- 안내 문구 복사 ---------- */
  document.addEventListener('click', function (e) {
    var b = e.target.closest('.copy');
    if (!b || b.closest('[contenteditable="true"]')) return;
    var body = $('.script-body', b.closest('.script'));
    var text = body.innerText;
    function ok() { b.textContent = '복사됨'; b.classList.add('ok'); setTimeout(function () { b.textContent = '복사'; b.classList.remove('ok'); }, 1500); }
    function fallback() {
      var r = document.createRange(); r.selectNodeContents(body);
      var s = window.getSelection(); s.removeAllRanges(); s.addRange(r);
      b.textContent = '선택됨 · Ctrl+C';
      setTimeout(function () { b.textContent = '복사'; }, 2500);
    }
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(ok, fallback);
      else fallback();
    } catch (err) { fallback(); }
  });

  /* ---------- HTML 정리 (저장·표시 전) ---------- */
  var ALLOWED = { P:1, H3:1, H4:1, UL:1, OL:1, LI:1, B:1, STRONG:1, I:1, EM:1, U:1, BR:1, SPAN:1, DIV:1, A:1,
    TABLE:1, THEAD:1, TBODY:1, TR:1, TH:1, TD:1, DETAILS:1, SUMMARY:1, FIGURE:1, FIGCAPTION:1, BUTTON:1, TIME:1, SMALL:1, IMG:1 };
  var DROP = { SCRIPT:1, STYLE:1, IFRAME:1, OBJECT:1, EMBED:1, LINK:1, META:1, SVG:1, MATH:1, TEMPLATE:1, FORM:1, INPUT:1, TEXTAREA:1, SELECT:1, VIDEO:1, AUDIO:1 };
  function cleanNode(node) {
    var child = node.firstChild;
    while (child) {
      var next = child.nextSibling;
      if (child.nodeType === 8) { node.removeChild(child); }
      else if (child.nodeType === 1) {
        var tag = child.tagName.toUpperCase();
        if (child.classList.contains('edit-stamp') || DROP[tag]) { node.removeChild(child); }
        else if (!ALLOWED[tag]) {
          var first = child.firstChild;
          while (child.firstChild) node.insertBefore(child.firstChild, child);
          node.removeChild(child);
          if (first) next = first;
        } else {
          Array.prototype.slice.call(child.attributes).forEach(function (at) {
            var n = at.name.toLowerCase(), v = at.value;
            var keep =
              (n === 'class' && /^[\w\- ]*$/.test(v)) ||
              (n === 'href' && /^(https?:\/\/[^\s"'<>]+|#[\w-]*)$/.test(v)) ||
              (n === 'target' && v === '_blank') || (n === 'rel' && /^[\w ]*$/.test(v)) ||
              (n === 'data-go' && /^[\w-]+$/.test(v)) || (n === 'open') ||
              (n === 'type' && tag === 'BUTTON' && v === 'button') ||
              (n === 'style' && /^counter-reset: st \d+;?$/.test(v)) ||
              (n === 'title' && v.length < 80) ||
              (tag === 'IMG' && n === 'src' && /^\/_blob\/[A-Za-z0-9_-]{8,64}$/.test(v)) ||
              (tag === 'IMG' && n === 'alt' && v.length < 200);
            if (!keep) child.removeAttribute(at.name);
          });
          if (child.classList.contains('tcur')) { child.classList.remove('tcur'); if (!child.className) child.removeAttribute('class'); }
          if (tag === 'IMG' && !child.getAttribute('src')) { node.removeChild(child); child = next; continue; }
          if (tag === 'A' && child.getAttribute('href') && /^https?:/.test(child.getAttribute('href'))) { child.setAttribute('target', '_blank'); child.setAttribute('rel', 'noopener'); }
          cleanNode(child);
        }
      }
      child = next;
    }
  }
  function sanitize(html) {
    var t = document.createElement('template');
    t.innerHTML = html || '';
    $$('mark.hit', t.content).forEach(function (m) { m.replaceWith(document.createTextNode(m.textContent)); });
    cleanNode(t.content);
    return t.innerHTML.trim();
  }

  /* ---------- 내용 단위 구분 (수정 기록용) ---------- */
  function txt(node) {
    var out = [], w = document.createTreeWalker(node, NodeFilter.SHOW_TEXT, {
      acceptNode: function (n) { return n.parentNode.closest && n.parentNode.closest('.copy, .edit-stamp') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT; } });
    while (w.nextNode()) out.push(w.currentNode.nodeValue);
    return norm(out.join(' '));
  }
  function sectionsOf(root) {
    var cur = '도입부', map = {}, order = [], firstEl = {};
    Array.prototype.slice.call(root.children).forEach(function (node) {
      var key;
      if (node.tagName === 'H3') { cur = txt(node) || '(제목 없음)'; key = cur; }
      else if (node.matches && node.matches('details.case')) {
        var t = node.querySelector('.case-t') || node.querySelector('summary');
        key = cur + ' › ' + (t ? txt(t) : '항목');
      } else key = cur;
      if (!map[key]) { map[key] = { html: '', blocks: [] }; order.push(key); firstEl[key] = node; }
      map[key].html += node.outerHTML;
      map[key].blocks.push({ html: node.outerHTML, text: txt(node) });
    });
    return { map: map, order: order, firstEl: firstEl };
  }
  function sectionsFromHtml(html) {
    var t = document.createElement('template'); t.innerHTML = html || '';
    var d = document.createElement('div'); d.appendChild(t.content);
    return sectionsOf(d);
  }
  function clip(x) { return x.length > 160 ? x.slice(0, 160) + '…' : x; }
  function snip(a, b) {
    var p = 0; while (p < a.length && p < b.length && a[p] === b[p]) p++;
    var s = 0; while (s < a.length - p && s < b.length - p && a[a.length - 1 - s] === b[b.length - 1 - s]) s++;
    function cut(x) {
      var from = Math.max(0, p - 20), to = Math.min(x.length, x.length - s + 20);
      return (from > 0 ? '…' : '') + clip(x.slice(from, to)) + (to < x.length ? '…' : '');
    }
    return { before: cut(a), after: cut(b) };
  }
  function blockDiff(A, B) {
    // LCS over block html, then group consecutive non-matching runs
    var n = A.length, m = B.length, L = [], i, j;
    for (i = 0; i <= n; i++) { L.push(new Array(m + 1).fill(0)); }
    for (i = n - 1; i >= 0; i--) for (j = m - 1; j >= 0; j--)
      L[i][j] = A[i].html === B[j].html ? L[i + 1][j + 1] + 1 : Math.max(L[i + 1][j], L[i][j + 1]);
    var groups = [], g = null; i = 0; j = 0;
    function flush() { if (g) { groups.push(g); g = null; } }
    while (i < n || j < m) {
      if (i < n && j < m && A[i].html === B[j].html) { flush(); i++; j++; }
      else {
        if (!g) g = { a: [], b: [] };
        if (j < m && (i >= n || L[i][j + 1] >= L[i + 1][j])) { g.b.push(B[j]); j++; }
        else { g.a.push(A[i]); i++; }
      }
    }
    flush();
    return groups;
  }
  function diffSections(beforeHtml, afterHtml) {
    var A = sectionsFromHtml(beforeHtml), B = sectionsFromHtml(afterHtml), out = [];
    var keys = B.order.slice(); A.order.forEach(function (k) { if (keys.indexOf(k) < 0) keys.push(k); });
    keys.forEach(function (k) {
      var a = A.map[k], b = B.map[k];
      if (a && b && a.html === b.html) return;
      if (!a) { var tb0 = norm(b.blocks.map(function (x) { return x.text; }).join(' ')); out.push({ section: k, kind: '추가', before: '', after: clip(tb0), afterFull: tb0.slice(0, 4000) }); return; }
      if (!b) { var ta0 = norm(a.blocks.map(function (x) { return x.text; }).join(' ')); out.push({ section: k, kind: '삭제', before: clip(ta0), after: '', beforeFull: ta0.slice(0, 4000) }); return; }
      blockDiff(a.blocks, b.blocks).forEach(function (gr) {
        var ta = norm(gr.a.map(function (x) { return x.text; }).join(' ')), tb = norm(gr.b.map(function (x) { return x.text; }).join(' '));
        var F = 4000;
        if (!gr.a.length) out.push({ section: k, kind: '추가', before: '', after: clip(tb), afterFull: tb.slice(0, F) });
        else if (!gr.b.length) out.push({ section: k, kind: '삭제', before: clip(ta), after: '', beforeFull: ta.slice(0, F) });
        else if (ta === tb) out.push({ section: k, kind: '서식', before: '', after: '글자는 같고 서식·구성이 바뀜' });
        else { var sn = snip(ta, tb); out.push({ section: k, kind: '수정', before: sn.before, after: sn.after, beforeFull: ta.slice(0, F), afterFull: tb.slice(0, F) }); }
      });
    });
    return out.slice(0, 40);
  }

  /* ---------- 검색 ---------- */
  var index = [], files = [];
  function buildIndex() {
    index = Object.keys(pages).map(function (slug) {
      var p = pages[slug];
      var fn = files.filter(function (f) { return f.slug === slug; }).map(function (f) { return '[자료] ' + titleOf(f) + ' ' + (f.kind === 'link' ? hostOf(f.url) : f.name); }).join(' ');
      return { slug: slug, title: p.title, crumb: p.crumb, head: (p.title + ' ' + p.crumb).toLowerCase(), text: norm(txt(p.c) + ' ' + fn) };
    });
  }
  var q = $('#q'), results = $('#search-results'), sel = -1, lastTerms = [];
  function terms(s) { return norm(s).toLowerCase().split(' ').filter(Boolean); }
  function markInto(parent, text, ts) {
    var lower = text.toLowerCase(), i = 0;
    while (i < text.length) {
      var best = -1, len = 0;
      ts.forEach(function (t) { var j = lower.indexOf(t, i); if (j >= 0 && (best < 0 || j < best)) { best = j; len = t.length; } });
      if (best < 0) { parent.appendChild(document.createTextNode(text.slice(i))); break; }
      if (best > i) parent.appendChild(document.createTextNode(text.slice(i, best)));
      parent.appendChild(el('mark', null, text.slice(best, best + len)));
      i = best + len;
    }
  }
  function runSearch() {
    var ts = terms(q.value); lastTerms = ts; sel = -1;
    results.textContent = '';
    if (!ts.length) { results.hidden = true; q.setAttribute('aria-expanded', 'false'); return; }
    var hits = [];
    index.forEach(function (it) {
      var lt = it.text.toLowerCase(), score = 0, ok = true;
      ts.forEach(function (t) {
        var inHead = it.head.indexOf(t) >= 0, n = 0, j = lt.indexOf(t);
        while (j >= 0 && n < 50) { n++; j = lt.indexOf(t, j + t.length); }
        if (!inHead && !n) ok = false;
        score += (inHead ? 20 : 0) + n;
      });
      if (ok) hits.push({ it: it, score: score });
    });
    hits.sort(function (a, b) { return b.score - a.score; });
    if (!hits.length) {
      var li = el('li', 'sr-empty', '"' + norm(q.value) + '"에 맞는 내용이 없습니다.'); results.appendChild(li);
    }
    hits.slice(0, 15).forEach(function (h, i) {
      var li = el('li'); var a = el('a'); a.href = '#' + h.it.slug; a.setAttribute('data-slug', h.it.slug); a.id = 'sr-' + i;
      var t = el('span', 'sr-title'); markInto(t, h.it.title, ts);
      var c = el('span', 'sr-crumb', h.it.crumb);
      a.appendChild(t); a.appendChild(c);
      var lt = h.it.text.toLowerCase(), pos = -1;
      ts.forEach(function (x) { var j = lt.indexOf(x); if (j >= 0 && (pos < 0 || j < pos)) pos = j; });
      if (pos >= 0) {
        var from = Math.max(0, pos - 30), s = (from ? '…' : '') + h.it.text.slice(from, pos + 70) + '…';
        var sn = el('span', 'sr-snip'); markInto(sn, s, ts); a.appendChild(sn);
      }
      li.appendChild(a); results.appendChild(li);
    });
    results.hidden = false; q.setAttribute('aria-expanded', 'true');
  }
  q.addEventListener('input', runSearch);
  q.addEventListener('focus', function () { if (q.value) runSearch(); });
  q.addEventListener('keydown', function (e) {
    var items = $$('a', results);
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      if (!items.length) return; e.preventDefault();
      sel = (sel + (e.key === 'ArrowDown' ? 1 : -1) + items.length) % items.length;
      items.forEach(function (a, i) { a.classList.toggle('on', i === sel); });
      items[sel].scrollIntoView({ block: 'nearest' });
    } else if (e.key === 'Enter') {
      var a = items[sel >= 0 ? sel : 0]; if (a) { e.preventDefault(); openHit(a.getAttribute('data-slug')); }
    } else if (e.key === 'Escape') { results.hidden = true; q.blur(); }
  });
  results.addEventListener('click', function (e) {
    var a = e.target.closest('a[data-slug]'); if (!a) return;
    e.preventDefault(); openHit(a.getAttribute('data-slug'));
  });
  document.addEventListener('click', function (e) { if (!e.target.closest('.search')) results.hidden = true; });
  function clearHits() {
    $$('mark.hit').forEach(function (m) { var p = m.parentNode; m.replaceWith(document.createTextNode(m.textContent)); if (p) p.normalize(); });
  }
  function openHit(slug) {
    results.hidden = true;
    go(slug);
    if (current !== slug) return;
    var c = pages[slug].c, ts = lastTerms, first = null;
    var walker = document.createTreeWalker(c, NodeFilter.SHOW_TEXT, {
      acceptNode: function (n) { return n.parentNode.closest('.copy, .edit-stamp') ? NodeFilter.FILTER_REJECT : NodeFilter.FILTER_ACCEPT; }
    });
    var nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach(function (n) {
      var lower = n.nodeValue.toLowerCase();
      if (!ts.some(function (t) { return lower.indexOf(t) >= 0; })) return;
      var frag = document.createDocumentFragment(); markInto(frag, n.nodeValue, ts);
      $$('mark', frag).forEach(function (m) { m.className = 'hit'; if (!first) first = m; });
      n.parentNode.replaceChild(frag, n);
    });
    if (first) {
      var d = first.closest('details'); while (d) { d.open = true; d = d.parentElement && d.parentElement.closest('details'); }
      setTimeout(function () { first.scrollIntoView({ block: 'center' }); }, 30);
    }
  }

  /* ---------- 상태 표시 ---------- */
  var people = {};   // id -> name (표시용, 저장하지 않음)
  function nameOf(id) { return (id && people[id]) || (id ? '팀원' : '알 수 없음'); }
  function refreshStatus(slug) {
    var p = pages[slug], has = norm(p.c.textContent).length > 0;
    var st = $('.status', p.a);
    if (st) { st.textContent = has ? '자료 반영' : '작성 전'; st.classList.toggle('done', has); }
    p.a.classList.toggle('is-empty', !has);
    var link = $('.sub a[data-go="' + slug + '"]');
    if (link) {
      var dot = $('.dot', link);
      if (has && !dot) { dot = el('i', 'dot'); dot.title = '내용 있음'; link.appendChild(dot); }
      if (!has && dot) dot.remove();
    }
    var chip = $('.chip[data-go="' + slug + '"]'); if (chip) chip.classList.toggle('filled', has);
    var meta = $('.page-meta', p.a);
    if (p.override && p.override.updatedAt) {
      meta.textContent = '최종 수정 ' + fmt(p.override.updatedAt, true) + ' · ' + nameOf(p.override.updatedBy);
    } else meta.textContent = '기본 내용';
  }
  function refreshCounts() {
    var n = Object.keys(pages).filter(function (s) { return /^s/.test(s) && norm(pages[s].c.textContent); }).length;
    $('#filled-count').textContent = n;
  }

  /* ---------- 편집 ---------- */
  var db = null, user = null, myId = null, canWrite = false, isOwnerFlag = false;
  var holder = 'tab-' + Math.random().toString(36).slice(2);
  var editing = null;
  var bar = $('#editbar'), barMsg = $('#editbar-msg');

  function effectiveHtml(slug) {
    var p = pages[slug];
    return sanitize(p.override ? p.override.html : p.base);
  }

      $$('.file-item:not(.pending)', ul).forEach(function (x) { x.remove(); });
      mine.forEach(function (f) { ul.appendChild(fileRow(f)); });
      $('.files-count', sec).textContent = mine.length ? String(mine.length) : '';
      $('.files-empty', sec).hidden = mine.length > 0 || !!$('.pending', ul);
      sec.hidden = !mine.length && !canUpload() && !$('.pending', ul) && !$('.stage', sec);
      if ($('.stage', sec)) $('.files-empty', sec).hidden = true;
    });
  }
  function refreshFilesUI() {
    var up = canUpload();
    $$('.upload-btn, .link-btn, .files-hint').forEach(function (b) { b.hidden = !up; });
    renderFiles();
  }
  document.addEventListener('click', function (e) {
    var lb = e.target.closest('.link-btn'); if (!lb) return;
    openLinkForm(lb.closest('article.page').getAttribute('data-page'));
  });
  document.addEventListener('click', function (e) {
    var b = e.target.closest('.upload-btn'); if (!b) return;
    $('.file-input', b.closest('.files')).click();
  });
  document.addEventListener('change', function (e) {
    if (!e.target.classList || !e.target.classList.contains('file-input')) return;
    var slug = e.target.closest('article.page').getAttribute('data-page');
    var list = Array.prototype.slice.call(e.target.files || []);
    e.target.value = '';
    if (list.length) stageFiles(slug, list);
  });
  document.addEventListener('dragover', function (e) {
    var a = e.target.closest && e.target.closest('article.page[data-title]');
    if (!a || !canUpload() || !e.dataTransfer || Array.prototype.indexOf.call(e.dataTransfer.types || [], 'Files') < 0) return;
    if (a.classList.contains('editing') && e.target.closest('.content')) return;
    e.preventDefault(); $('.files', a).classList.add('drag-over');
  });
  document.addEventListener('dragleave', function (e) {
    if (!e.relatedTarget || !e.relatedTarget.closest || !e.relatedTarget.closest('article.page')) $$('.files.drag-over').forEach(function (s) { s.classList.remove('drag-over'); });
  });
  document.addEventListener('drop', function (e) {
    var a = e.target.closest && e.target.closest('article.page[data-title]');
    $$('.files.drag-over').forEach(function (s) { s.classList.remove('drag-over'); });
    if (!a || !canUpload() || !e.dataTransfer || !e.dataTransfer.files || !e.dataTransfer.files.length) return;
    if (a.classList.contains('editing') && e.target.closest('.content')) return;
    e.preventDefault();
    stageFiles(a.getAttribute('data-page'), Array.prototype.slice.call(e.dataTransfer.files));
  });

  $('#hist-clear').addEventListener('click', async function () {
    var b = this;
    if (!b.classList.contains('armed')) {
      b.classList.add('armed'); b.textContent = '한 번 더 누르면 모든 기록을 지웁니다';
      setTimeout(function () { b.classList.remove('armed'); b.textContent = '기록 전체 삭제'; }, 5000); return;
    }
    b.disabled = true; b.textContent = '지우는 중…';
    var n = 0;
    try {
      for (var round = 0; round < 50; round++) {
        var snap = await db.collection('history').limit(100).get();
        if (snap.empty) break;
        for (var i = 0; i < snap.docs.length; i++) { await db.doc('history/' + snap.docs[i].id).delete(); n++; }
      }
      toast('기록 ' + n + '건을 모두 삭제했습니다.');
    } catch (e) { toast('일부만 삭제했습니다 (' + n + '건). 다시 눌러 주세요.'); }
    b.disabled = false; b.classList.remove('armed'); b.textContent = '기록 전체 삭제';
  });

  /* ---------- 공유 저장소 연결 ---------- */
  function setSync(state, text) { $('.sync').className = 'sync ' + state; $('#sync-text').textContent = text; }
  async function connect() {
    if (!window.claude || !window.claude.use) { setSync('off', '기본 내용 보기 (실시간 수정 불가)'); return; }
    var dbP = window.claude.use('db'), userP = window.claude.use('user'), asP = window.claude.use('assets'), dlP = window.claude.use('downloads');
    dlP.then(function (x) { downloads = x; });
    db = await dbP; user = await userP;
    if (!db) { setSync('off', '기본 내용 보기 · 로그인하면 팀 수정 내용이 보입니다'); return; }
    if (user) { try { myId = await user.id(); } catch (e) {} try { isOwnerFlag = await user.isOwner(); } catch (e) {} }
    var w = null; try { w = user ? await user.can('data.write') : null; } catch (e) {}
    canWrite = w !== false;
    if (canWrite) {
      $$('.edit-btn').forEach(function (b) { b.hidden = false; });
      $$('.can-edit-hint').forEach(function (b) { b.hidden = false; });
    }
    asP.then(function (a) { assets = a; refreshFilesUI(); });
    refreshFilesUI();
    setSync('live', canWrite ? '실시간 동기화 중' : '실시간 보기 (읽기 전용)');

    db.collection('pages').onSnapshot(async function (snap) {
      var seen = {};
      snap.docs.forEach(function (d) {
        if (!pages[d.id]) return; seen[d.id] = 1;
        var data = d.data();
        var p = pages[d.id];
        if (p.override && p.override.updatedAt === data.updatedAt && p.override.html === data.html) return;
        p.override = { html: String(data.html || ''), updatedAt: data.updatedAt || 0, updatedBy: data.updatedBy || null };
        if (editing && editing.slug === d.id) {
          if (data.updatedAt !== editing.startAt) { barMsg.textContent = '방금 ' + nameOf(data.updatedBy) + '님이 이 페이지를 저장했습니다. 저장하면 내 수정으로 덮어씁니다.'; barMsg.className = 'editbar-msg warn'; }
          return;
        }
        applyContent(d.id);
      });
      Object.keys(pages).forEach(function (s) {
        if (!seen[s] && pages[s].override) { pages[s].override = null; if (!editing || editing.slug !== s) applyContent(s); }
      });
      await resolvePeople();
      Object.keys(pages).forEach(function (s) { refreshStatus(s); if (!editing || editing.slug !== s) renderStamps(s); });
      refreshCounts(); buildIndex();
    }, function () { setSync('off', '연결이 끊겼습니다 · 새로고침해 주세요'); });

    db.collection('files').onSnapshot(async function (snap) {
      files = snap.docs.map(function (d) { var x = d.data(); return {
        id: d.id, kind: x.kind === 'link' ? 'link' : 'file',
        url: (typeof x.url === 'string' && /^https?:\/\/[^\s"'<>]+$/.test(x.url)) ? x.url.slice(0, 2000) : '',
        slug: String(x.slug || ''), name: String(x.name || '파일'), title: String(x.title || '').slice(0, 120), size: Number(x.size) || 0, type: String(x.type || ''),
        assetId: String(x.assetId || ''), enc: x.enc === 'base64' ? 'base64' : x.enc === 'parts' ? 'parts' : x.enc === 'db' ? 'db' : 'raw',
        dbParts: Math.min(200, Math.max(0, Number(x.dbParts) || 0)),
        parts: Array.isArray(x.parts) ? x.parts.filter(function (id) { return /^[A-Za-z0-9_-]{8,64}$/.test(String(id)); }).slice(0, 10).map(String) : null, at: Number(x.at) || 0, by: x.by || null }; })
        .filter(function (f) { return pages[f.slug] && (f.kind === 'link' ? !!f.url : /^[A-Za-z0-9_-]{8,64}$/.test(f.assetId)); });
      await resolvePeople();
      renderFiles(); buildIndex();
    }, function () {});

    db.collection('history').orderBy('at', 'desc').limit(300).onSnapshot(async function (snap) {
      hist = snap.docs.map(function (d) { var x = d.data(); return {
        id: d.id, slug: String(x.slug || ''), title: String(x.title || ''), at: Number(x.at) || 0, by: x.by || null,
        kind: x.kind === 'restore' ? 'restore' : x.kind === 'file' ? 'file' : 'edit', prevHtml: typeof x.prevHtml === 'string' ? x.prevHtml : null,
        changes: Array.isArray(x.changes) ? x.changes.slice(0, 40).map(function (c) { return {
          section: String(c.section || ''), kind: String(c.kind || '수정'), before: String(c.before || ''), after: String(c.after || ''),
          beforeFull: String(c.beforeFull || ''), afterFull: String(c.afterFull || '') }; }) : []
      }; });
      await resolvePeople();
      renderHistory();
      Object.keys(pages).forEach(refreshStatus);
    }, function () {});
  }

  /* ---------- 시작 ---------- */
  Object.keys(pages).forEach(function (s) { pages[s].c.innerHTML = sanitize(pages[s].base); relabel(pages[s].c); pages[s].base = pages[s].c.innerHTML; refreshStatus(s); });
  buildIndex();
  show(location.hash.slice(1) || 'home', false);
  connect();
})();
</script>

</body></html>
